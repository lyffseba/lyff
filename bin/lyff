#!/usr/bin/env python3
"""lyff — offline portfolio hub CLI (center command for ~/lyff)."""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tarfile
import time
from pathlib import Path
from typing import Any

LYFF_ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = LYFF_ROOT / "registry.yaml"
DOCS_DIR = LYFF_ROOT / "docs"
VERSION = "0.2.0"

# Directory names pruned when walking for airplane bundles (regenerable / huge).
BUNDLE_EXCLUDE_DIRS = frozenset(
    {
        "node_modules",
        ".pixi",
        ".venv",
        "venv",
        "target",
        "dist",
        "build",
        ".next",
        ".turbo",
        "__pycache__",
        ".pytest_cache",
        ".lyff",
        ".mypy_cache",
        ".ruff_cache",
        "coverage",
        ".coverage",
    }
)
# Nested project .git is KEEP (offline history). Hub-only caches excluded above.

BUNDLE_EXCLUDE_FILE_NAMES = frozenset({".env", ".env.local", ".DS_Store"})
BUNDLE_EXCLUDE_SUFFIXES = (".db", ".log", ".pyc", ".tar.gz", ".tgz")


def _sid(v: Any) -> str:
    return "" if v is None else str(v)


def load_raw_registry() -> dict:
    text = REGISTRY_PATH.read_text(encoding="utf-8")
    try:
        import yaml  # type: ignore

        data = yaml.safe_load(text)
        if isinstance(data, dict):
            return data
    except Exception:
        pass
    cache = LYFF_ROOT / ".lyff" / "registry.json"
    if cache.exists():
        return json.loads(cache.read_text(encoding="utf-8"))
    return _minimal_parse(text)


def _minimal_parse(text: str) -> dict:
    """YAML subset parser when PyYAML is unavailable (still offline)."""
    projects: list[dict] = []
    cur: dict | None = None
    in_commands = False
    for raw in text.splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if stripped.startswith("- id:"):
            if cur:
                projects.append(cur)
            cur = {"id": stripped.split(":", 1)[1].strip().strip("\"'"), "commands": {}}
            in_commands = False
            continue
        if cur is None or not stripped or stripped.startswith("#"):
            continue
        if stripped == "commands:":
            in_commands = True
            continue
        if ":" not in stripped:
            continue
        key, _, val = stripped.partition(":")
        key, val = key.strip(), val.strip().strip("\"'")
        if key in (
            "path",
            "name",
            "status",
            "role",
            "offline_ok",
            "superseded_by",
            "remote",
        ):
            in_commands = False
            cur[key] = val
        elif in_commands and key and val:
            cur.setdefault("commands", {})[key] = val
        elif key == "stack":
            in_commands = False
    if cur:
        projects.append(cur)
    return {
        "version": 1,
        "offline": True,
        "motto": "First do it, then do it right, then do it better.",
        "projects": projects,
    }


def normalize_registry(reg: dict) -> dict:
    """Coerce types and fill defaults so consumers never see int ids."""
    projects = []
    for raw in reg.get("projects") or []:
        if not isinstance(raw, dict):
            continue
        pid = _sid(raw.get("id")).strip("\"'")
        path = _sid(raw.get("path") or pid).strip("\"'")
        cmds = raw.get("commands") or {}
        if not isinstance(cmds, dict):
            cmds = {}
        projects.append(
            {
                **raw,
                "id": pid,
                "path": path,
                "name": _sid(raw.get("name") or pid),
                "status": _sid(raw.get("status") or "unknown"),
                "role": _sid(raw.get("role") or "unknown"),
                "offline_ok": raw.get("offline_ok", "unknown"),
                "commands": {str(k): str(v) for k, v in cmds.items()},
            }
        )
    return {
        "version": reg.get("version", 1),
        "root": reg.get("root", "."),
        "motto": reg.get(
            "motto", "First do it, then do it right, then do it better."
        ),
        "offline": bool(reg.get("offline", True)),
        "projects": projects,
    }


def load_registry() -> dict:
    return normalize_registry(load_raw_registry())


def validate_registry(reg: dict, *, check_paths: bool = True) -> list[str]:
    """Return list of human-readable validation errors (empty = ok).

    check_paths=False is for CI/hub-only checkouts (nested projects absent).
    """
    errors: list[str] = []
    if not reg.get("projects"):
        errors.append("registry has no projects")
    seen: set[str] = set()
    for p in reg.get("projects") or []:
        pid = p.get("id") or ""
        if not pid:
            errors.append("project missing id")
            continue
        if pid in seen:
            errors.append(f"duplicate project id: {pid}")
        seen.add(pid)
        if not p.get("path"):
            errors.append(f"{pid}: missing path")
        if check_paths:
            path = LYFF_ROOT / (p.get("path") or pid)
            if not path.is_dir():
                errors.append(f"{pid}: path missing: {path}")
            elif not (path / ".git").exists():
                errors.append(f"{pid}: not a git repo: {path}")
        for cname, cval in (p.get("commands") or {}).items():
            if not str(cval).strip():
                errors.append(f"{pid}: empty command '{cname}'")
    return errors


def cache_registry(reg: dict) -> None:
    cache_dir = LYFF_ROOT / ".lyff"
    cache_dir.mkdir(exist_ok=True)
    (cache_dir / "registry.json").write_text(
        json.dumps(reg, indent=2), encoding="utf-8"
    )


def git(cwd: Path, *args: str) -> str:
    try:
        return subprocess.check_output(
            ["git", "-C", str(cwd), *args],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""


def project_by_id(reg: dict, pid: str) -> dict | None:
    for p in reg.get("projects") or []:
        if p.get("id") == str(pid):
            return p
    return None


def project_path(p: dict) -> Path:
    return LYFF_ROOT / (p.get("path") or p["id"])


def cmd_help() -> None:
    print(
        f"""lyff {VERSION} — offline portfolio hub

Usage:
  lyff status              Nested repo status (no network)
  lyff doctor              Toolchain + paths + registry validation
  lyff list                Projects from registry
  lyff validate            Validate registry only
  lyff info <id>           JSON details for one project
  lyff path <id>           Absolute path
  lyff docs [topic]        Print docs (index|offline|portfolio|…)
  lyff run <id> <cmd>      Named command from registry
  lyff run <id> -- <sh>    Arbitrary shell in project dir
  lyff foreach <sh…>       Run shell in every project
  lyff bundle [out.tgz]    Offline tarball of hub + projects
  lyff registry            Show registry path
  lyff root                Show hub root
  lyff version             Print CLI version
  lyff help                This help

Docs: docs/index.md
Remote: https://github.com/lyffseba/lyff
Motto: First do it, then do it right, then do it better.
"""
    )


def cmd_list(reg: dict) -> None:
    print(f"{'ID':12} {'STATUS':12} {'ROLE':10} {'OFFLINE':10} NAME")
    print("-" * 72)
    for p in reg.get("projects") or []:
        print(
            f"{p['id']:12} {p.get('status', ''):12} "
            f"{p.get('role', ''):10} {str(p.get('offline_ok', '')):10} "
            f"{p.get('name', '')}"
        )


def cmd_status(reg: dict) -> None:
    print(f"lyff hub @ {LYFF_ROOT}  (cli {VERSION})")
    print(f"offline={reg.get('offline')}  {reg.get('motto', '')}")
    print()
    print(f"{'ID':12} {'BRANCH':12} {'DIRTY':6} {'OFFLINE':10} HEAD")
    print("-" * 90)
    for p in reg.get("projects") or []:
        path = project_path(p)
        pid = p["id"]
        if not path.is_dir():
            print(
                f"{pid:12} {'—':12} {'MISS':6} "
                f"{str(p.get('offline_ok', '')):10} (missing directory)"
            )
            continue
        branch = git(path, "rev-parse", "--abbrev-ref", "HEAD") or "?"
        dirty_txt = git(path, "status", "--porcelain")
        dirty = str(len(dirty_txt.splitlines()) if dirty_txt else 0)
        head = git(path, "log", "-1", "--format=%h %s") or "(no commits)"
        if len(head) > 52:
            head = head[:49] + "..."
        print(
            f"{pid:12} {branch:12} {dirty:6} "
            f"{str(p.get('offline_ok', '')):10} {head}"
        )


def cmd_doctor(reg: dict) -> int:
    issues = 0

    def check(name: str, ok: bool, detail: str = "") -> None:
        nonlocal issues
        mark = "OK " if ok else "!! "
        if not ok:
            issues += 1
        print(f"  {mark}{name}" + (f" — {detail}" if detail else ""))

    print("Toolchain (presence only; missing tools are fine if unused)")
    tools = [
        ("git", ["git", "--version"]),
        ("node", ["node", "-v"]),
        ("npm", ["npm", "-v"]),
        ("cargo", ["cargo", "-V"]),
        ("go", ["go", "version"]),
        ("python3", ["python3", "--version"]),
        ("pixi", ["pixi", "--version"]),
        ("make", ["make", "--version"]),
        ("cc", ["cc", "--version"]),
    ]
    for name, argv in tools:
        try:
            out = subprocess.check_output(
                argv, text=True, stderr=subprocess.STDOUT
            ).splitlines()[0]
            check(name, True, out[:60])
        except Exception:
            check(name, False, "not found")

    print("\nRegistry")
    for err in validate_registry(reg):
        check(err, False)
    if not validate_registry(reg):
        check("registry valid", True, f"{len(reg.get('projects') or [])} projects")

    print("\nProjects")
    for p in reg.get("projects") or []:
        path = project_path(p)
        pid = p["id"]
        ok = path.is_dir() and (path / ".git").exists()
        check(pid, ok, str(path) if ok else f"missing {path}")
        if ok:
            dirty = git(path, "status", "--porcelain")
            if dirty:
                check(
                    f"{pid} clean",
                    False,
                    f"{len(dirty.splitlines())} dirty paths",
                )

    print("\nHub")
    check("registry.yaml", REGISTRY_PATH.is_file())
    check("docs/index.md", (DOCS_DIR / "index.md").is_file())
    check("bin/lyff", (LYFF_ROOT / "bin" / "lyff").is_file())
    check("executable bit", os.access(LYFF_ROOT / "bin" / "lyff", os.X_OK))

    print()
    if issues:
        print(
            f"doctor: {issues} issue(s) flagged — hub docs/status still offline-safe"
        )
        return 1
    print("doctor: all clear")
    return 0


def cmd_validate(reg: dict, *, check_paths: bool = True) -> int:
    errs = validate_registry(reg, check_paths=check_paths)
    if errs:
        for e in errs:
            print(f"error: {e}", file=sys.stderr)
        return 1
    mode = "full" if check_paths else "schema"
    print(f"registry ok ({mode}, {len(reg.get('projects') or [])} projects)")
    return 0


def cmd_info(reg: dict, pid: str) -> None:
    p = project_by_id(reg, pid)
    if not p:
        print(f"unknown project: {pid}", file=sys.stderr)
        print("known:", ", ".join(x["id"] for x in reg.get("projects") or []), file=sys.stderr)
        sys.exit(1)
    path = project_path(p)
    print(
        json.dumps(
            {
                **p,
                "abs_path": str(path),
                "branch": git(path, "rev-parse", "--abbrev-ref", "HEAD")
                if path.is_dir()
                else None,
                "head": git(path, "log", "-1", "--format=%h %s")
                if path.is_dir()
                else None,
                "dirty": bool(git(path, "status", "--porcelain"))
                if path.is_dir()
                else None,
            },
            indent=2,
        )
    )


def cmd_path(reg: dict, pid: str) -> None:
    p = project_by_id(reg, pid)
    if not p:
        print(f"unknown project: {pid}", file=sys.stderr)
        sys.exit(1)
    print(project_path(p))


def cmd_docs(topic: str | None) -> None:
    topic = topic or "index"
    candidates = [
        DOCS_DIR / f"{topic}.md",
        DOCS_DIR / topic / "index.md",
    ]
    for c in candidates:
        if c.is_file():
            sys.stdout.write(c.read_text(encoding="utf-8"))
            return
    print(f"no doc for topic: {topic}", file=sys.stderr)
    topics = sorted(p.stem for p in DOCS_DIR.glob("*.md"))
    print("available:", ", ".join(topics), file=sys.stderr)
    sys.exit(1)


def cmd_run(reg: dict, pid: str, rest: list[str]) -> None:
    p = project_by_id(reg, pid)
    if not p:
        print(f"unknown project: {pid}", file=sys.stderr)
        sys.exit(1)
    path = project_path(p)
    if not path.is_dir():
        print(f"missing directory: {path}", file=sys.stderr)
        sys.exit(1)
    cmds = p.get("commands") or {}
    if rest and rest[0] == "--":
        shell_cmd = " ".join(rest[1:])
    elif rest and rest[0] in cmds:
        shell_cmd = cmds[rest[0]]
    elif rest:
        shell_cmd = " ".join(rest)
    else:
        print(f"usage: lyff run {pid} <cmd|-- shell…>", file=sys.stderr)
        print("named commands:", ", ".join(cmds) or "(none)", file=sys.stderr)
        sys.exit(2)
    if not shell_cmd.strip():
        print("empty command", file=sys.stderr)
        sys.exit(2)
    print(f"+ ({path}) {shell_cmd}", flush=True)
    os.chdir(path)
    os.execvp("bash", ["bash", "-lc", shell_cmd])


def cmd_foreach(reg: dict, rest: list[str]) -> int:
    if not rest:
        print("usage: lyff foreach <shell command…>", file=sys.stderr)
        return 2
    shell_cmd = " ".join(rest)
    worst = 0
    for p in reg.get("projects") or []:
        path = project_path(p)
        pid = p["id"]
        if not path.is_dir():
            print(f"## {pid} (missing)")
            worst = max(worst, 1)
            continue
        print(f"## {pid}")
        rc = subprocess.call(["bash", "-lc", shell_cmd], cwd=path)
        if rc:
            worst = max(worst, rc)
    return worst


def _bundle_should_skip_file(path: Path, out_resolved: Path) -> bool:
    try:
        if path.resolve() == out_resolved:
            return True
    except Exception:
        pass
    name = path.name
    if name in BUNDLE_EXCLUDE_FILE_NAMES:
        return True
    if name.startswith(".env.") and name != ".env.example":
        return True
    if any(name.endswith(suf) for suf in BUNDLE_EXCLUDE_SUFFIXES):
        return True
    if name.startswith("lyff-offline-") and name.endswith((".tar.gz", ".tgz")):
        return True
    return False


def cmd_bundle(out_arg: str | None) -> int:
    """Create an offline tarball of the whole lyff tree (no network)."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = Path(out_arg) if out_arg else LYFF_ROOT / f"lyff-offline-{stamp}.tar.gz"
    if not out.is_absolute():
        out = Path.cwd() / out
    out.parent.mkdir(parents=True, exist_ok=True)
    out_resolved = out.resolve()

    print(f"bundling {LYFF_ROOT} → {out}", flush=True)
    count = 0
    with tarfile.open(out, "w:gz") as tar:
        for dirpath, dirnames, filenames in os.walk(LYFF_ROOT, followlinks=False):
            # Prune heavy / cache dirs; keep nested .git for offline git history
            dirnames[:] = sorted(
                d for d in dirnames if d not in BUNDLE_EXCLUDE_DIRS
            )
            rel_base = Path(dirpath).relative_to(LYFF_ROOT)
            for fn in sorted(filenames):
                fp = Path(dirpath) / fn
                if not fp.is_file():
                    continue
                if _bundle_should_skip_file(fp, out_resolved):
                    continue
                arc = Path("lyff") / rel_base / fn
                tar.add(fp, arcname=str(arc), recursive=False)
                count += 1

    size_mb = out.stat().st_size / (1024 * 1024)
    print(f"done: {count} files, {size_mb:.1f} MiB → {out}")
    print(f"extract: tar -xzf {out.name} && cd lyff && ./bin/lyff status")
    return 0


def main() -> None:
    if not REGISTRY_PATH.is_file():
        print(f"missing registry: {REGISTRY_PATH}", file=sys.stderr)
        sys.exit(1)

    reg = load_registry()
    cache_registry(reg)

    args = sys.argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        cmd_help()
        return

    cmd = args[0]
    if cmd == "version" or cmd == "--version":
        print(VERSION)
    elif cmd == "status":
        cmd_status(reg)
    elif cmd == "doctor":
        sys.exit(cmd_doctor(reg))
    elif cmd == "validate":
        # --schema: structure only (CI without nested checkouts)
        check_paths = "--schema" not in args[1:]
        sys.exit(cmd_validate(reg, check_paths=check_paths))
    elif cmd == "list":
        cmd_list(reg)
    elif cmd == "info":
        if len(args) < 2:
            print("usage: lyff info <id>", file=sys.stderr)
            sys.exit(2)
        cmd_info(reg, args[1])
    elif cmd == "path":
        if len(args) < 2:
            print("usage: lyff path <id>", file=sys.stderr)
            sys.exit(2)
        cmd_path(reg, args[1])
    elif cmd == "docs":
        cmd_docs(args[1] if len(args) > 1 else "index")
    elif cmd == "run":
        if len(args) < 2:
            print("usage: lyff run <id> …", file=sys.stderr)
            sys.exit(2)
        cmd_run(reg, args[1], args[2:])
    elif cmd == "foreach":
        sys.exit(cmd_foreach(reg, args[1:]))
    elif cmd == "bundle":
        sys.exit(cmd_bundle(args[1] if len(args) > 1 else None))
    elif cmd == "registry":
        print(REGISTRY_PATH)
    elif cmd == "root":
        print(LYFF_ROOT)
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        print("try: lyff help", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
